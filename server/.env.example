# NODAL API server configuration — copy to .env and fill in your own values.
# NEVER commit the real .env file.

PORT=3001

# MySQL database
RDS_HOST=your-db-host
RDS_PORT=3306
RDS_USER=your-db-user
RDS_PASSWORD=your-db-password
RDS_DATABASE=nodal
RDS_SSL=false

# Object storage (uploads)
OBS_AK=your-access-key
OBS_SK=your-secret-key
OBS_ENDPOINT=your-obs-endpoint
OBS_BUCKET=your-bucket-name

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# AI provider: "gemini" (cloud) or "ollama" (local)
AI_PROVIDER=gemini

# Local model via Ollama (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
