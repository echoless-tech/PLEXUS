rules_version = '2';

// =====================================================================
// PLEXUS — Progressive Payment Contracts
// Firestore Security Rules (Standard edition, default-deny)
//
// THREAT MODEL
//   Two mutually distrustful parties (SME and Buyer) share a contract, and a
//   third party (Funder) may observe agreements the SME chooses to list.
//   Nobody may: read contracts they are not entitled to; alter agreed
//   amounts/terms after acceptance; move a milestone through the payment
//   workflow out of order or on another party's behalf; forge audit events
//   or timestamps; grant themselves "verified" status; change their account
//   type after choosing it; or (as a funder) read any settlement details.
//
// DATA MODEL
//   profiles/{uid}                    public storefront data (any signed-in user reads)
//   profiles/{uid}/documents/{d}      PRIVATE business documents — Run section (owner only)
//   verifications/{uid}               PRIVATE KYC summary (owner only; last-4 digits only)
//   contracts/{cid}                   agreement header (locked once active)
//   contracts/{cid}/private/payment   PRIVATE settlement details (two parties only)
//   contracts/{cid}/milestones/{m}    one doc per stage — role-gated state machine
//   contracts/{cid}/events/{e}        append-only audit trail, server-timestamped
//
// INVARIANTS ENFORCED HERE
//   • accountType ('business' | 'funder') is write-once.
//   • Only a BUSINESS with submitted verification may author an agreement.
//   • Only the SME edits terms, and only while status == 'draft'.
//   • 'proposed' terms are frozen: SME may only withdraw, cancel, or toggle
//     the seekingFunding flag.
//   • Only the invited buyer (matching email) can accept; acceptance sets
//     buyerUid to the caller, status 'active', and lockedAt = server time.
//   • After activation, milestone amounts/terms cannot change at all.
//   • SME: pending → evidence_submitted (must attach evidence) / withdraw.
//     Buyer: evidence_submitted → approved | pending(reject); approved → paid.
//     Either: evidence_submitted|approved → disputed. Resolve → pending
//     (either) or → approved (buyer only).
//   • FUNDER (verification submitted) may READ header/milestones/events of
//     agreements with seekingFunding == true and status ∉ {draft, cancelled}.
//     Funders can never write to a contract and never read private/payment.
//   • Every timestamp that matters equals request.time (no client clocks).
//   • Audit events: create-only, actor must be caller, never updated/deleted.
//   • Business documents: create/delete only, never edited; AI fields reserved.
//   • Clients may never set verificationStatus to 'verified'.
//   • Every string/list/map has a hard size cap (mirrors src/types LIMITS).
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────── Helpers ─────────────────────────────

    function isAuthed() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function callerEmail() {
      return ('email' in request.auth.token) ? request.auth.token.email.lower() : '';
    }

    function strLen(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function optStr(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    function optTs(v) {
      return v == null || v is timestamp;
    }

    function isEmail(v) {
      return v is string && v.size() >= 5 && v.size() <= 254 &&
        v.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') && v == v.lower();
    }

    function isIsoDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isMoney(v, max) {
      return v is number && v >= 0 && v <= max;
    }

    function profilePath(u) {
      return /databases/$(database)/documents/profiles/$(u);
    }

    // A participant must have at least submitted verification (status
    // 'pending') before they can create or accept a payment agreement.
    // 'verified' can only ever be written server-side (Admin SDK).
    function hasSubmittedVerification(u) {
      return exists(profilePath(u)) &&
        get(profilePath(u)).data.verificationStatus in ['pending', 'verified'];
    }

    function contractPath(cid) {
      return /databases/$(database)/documents/contracts/$(cid);
    }

    // Current view of the parent contract — used by read rules.
    function parentNow(cid) {
      return get(contractPath(cid)).data;
    }

    // Post-batch view of the parent contract — used by write rules so a
    // contract and its milestones/events can be created atomically in one
    // batch. Safe because the contract write in that batch is itself
    // validated by the contract rules above.
    function parentAfter(cid) {
      return getAfter(contractPath(cid)).data;
    }

    function milestonePath(cid, mid) {
      return /databases/$(database)/documents/contracts/$(cid)/milestones/$(mid);
    }

    function milestoneNow(cid, mid) {
      return get(milestonePath(cid, mid)).data;
    }

    function milestoneAfter(cid, mid) {
      return getAfter(milestonePath(cid, mid)).data;
    }

    function isSmeOf(c) {
      return c.smeUid == uid();
    }

    function isBuyerOf(c) {
      return c.buyerUid != null && c.buyerUid == uid();
    }

    function isInvitedBuyerOf(c) {
      return c.buyerUid == null && c.buyerEmail == callerEmail() && callerEmail() != '';
    }

    function isParticipant(c) {
      return isSmeOf(c) || isBuyerOf(c);
    }

    function accountTypeOf(u) {
      return exists(profilePath(u)) ? get(profilePath(u)).data.accountType : null;
    }

    // Funders may observe agreements the SME has listed for funding — only once
    // they are out of draft, and only if the funder has submitted verification.
    function funderCanObserve(c) {
      return c.seekingFunding == true &&
        c.status in ['proposed', 'active', 'completed'] &&
        accountTypeOf(uid()) == 'funder' &&
        hasSubmittedVerification(uid());
    }

    // Drafts are private to the SME. Invited buyers see the proposal only.
    function canReadContract(c) {
      return isParticipant(c) ||
        (isInvitedBuyerOf(c) && c.status == 'proposed') ||
        funderCanObserve(c);
    }

    function isActorOn(c) {
      return isParticipant(c) || isInvitedBuyerOf(c);
    }

    // ───────────────────────── Shapes ──────────────────────────────

    function validPaymentInstructions(p) {
      return p is map &&
        p.keys().hasOnly(['method', 'accountHolder', 'bankName', 'accountNumber', 'branchCode', 'payshapId']) &&
        p.method in ['eft', 'payshap'] &&
        strLen(p.accountHolder, 1, 120) &&
        (!('bankName' in p) || strLen(p.bankName, 0, 64)) &&
        (!('accountNumber' in p) || strLen(p.accountNumber, 0, 32)) &&
        (!('branchCode' in p) || strLen(p.branchCode, 0, 16)) &&
        (!('payshapId' in p) || strLen(p.payshapId, 0, 64));
    }

    function contractKeys() {
      return ['smeUid', 'smeName', 'buyerUid', 'buyerEmail', 'buyerName', 'title', 'scope',
              'totalValue', 'currency', 'expectedDelivery', 'disputeRules', 'seekingFunding',
              'status', 'milestoneCount', 'smeAcceptedAt', 'buyerAcceptedAt', 'lockedAt',
              'completedAt', 'cancelledBy', 'cancelReason', 'createdAt', 'updatedAt'];
    }

    function validContractShape(d) {
      return d.keys().hasOnly(contractKeys()) && d.keys().hasAll(contractKeys()) &&
        d.smeUid is string && strLen(d.smeName, 1, 120) &&
        (d.buyerUid == null || d.buyerUid is string) &&
        isEmail(d.buyerEmail) && strLen(d.buyerName, 0, 120) &&
        strLen(d.title, 1, 120) && strLen(d.scope, 0, 2000) &&
        d.totalValue is number && d.totalValue > 0 && d.totalValue <= 100000000 &&
        d.currency == 'ZAR' && isIsoDate(d.expectedDelivery) &&
        strLen(d.disputeRules, 0, 2000) &&
        d.seekingFunding is bool &&
        d.status in ['draft', 'proposed', 'active', 'completed', 'cancelled'] &&
        d.milestoneCount is int && d.milestoneCount >= 1 && d.milestoneCount <= 12 &&
        optTs(d.smeAcceptedAt) && optTs(d.buyerAcceptedAt) && optTs(d.lockedAt) &&
        optTs(d.completedAt) && optStr(d.cancelledBy, 128) && optStr(d.cancelReason, 300) &&
        d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    function validEvidence(e) {
      return e is map &&
        e.keys().hasOnly(['type', 'note', 'fileName', 'dataUrl', 'submittedBy', 'submittedAt']) &&
        e.keys().hasAll(['type', 'note', 'fileName', 'dataUrl', 'submittedBy', 'submittedAt']) &&
        e.type in ['buyer_acknowledgement', 'delivery_confirmation', 'job_card', 'photo', 'document', 'other'] &&
        strLen(e.note, 0, 2000) && optStr(e.fileName, 160) &&
        (e.dataUrl == null || (e.dataUrl is string && e.dataUrl.size() <= 700000 &&
          e.dataUrl.matches('^data:(image/(png|jpeg|jpg|webp)|application/pdf);base64,.*'))) &&
        e.submittedBy is string && e.submittedAt is timestamp;
    }

    function milestoneKeys() {
      return ['contractId', 'order', 'title', 'percent', 'amount', 'dueCondition', 'acceptanceRule',
              'status', 'evidence', 'rejectionNote', 'approvedAt', 'paidAt', 'paymentReference',
              'disputeReason', 'disputedBy', 'disputedAt', 'resolutionNote', 'resolvedBy',
              'resolvedAt', 'updatedAt'];
    }

    function validMilestoneShape(d, cid) {
      return d.keys().hasOnly(milestoneKeys()) && d.keys().hasAll(milestoneKeys()) &&
        d.contractId == cid &&
        d.order is int && d.order >= 0 && d.order < 12 &&
        strLen(d.title, 1, 120) &&
        d.percent is number && d.percent >= 0 && d.percent <= 100 &&
        isMoney(d.amount, 100000000) &&
        strLen(d.dueCondition, 0, 300) && strLen(d.acceptanceRule, 0, 300) &&
        d.status in ['pending', 'evidence_submitted', 'approved', 'paid', 'disputed'] &&
        (d.evidence == null || validEvidence(d.evidence)) &&
        optStr(d.rejectionNote, 300) && optTs(d.approvedAt) && optTs(d.paidAt) &&
        optStr(d.paymentReference, 64) && optStr(d.disputeReason, 2000) &&
        optStr(d.disputedBy, 128) && optTs(d.disputedAt) && optStr(d.resolutionNote, 2000) &&
        optStr(d.resolvedBy, 128) && optTs(d.resolvedAt) && d.updatedAt is timestamp;
    }

    // A freshly authored milestone (draft phase) carries no workflow state.
    function isCleanMilestone(d) {
      return d.status == 'pending' && d.evidence == null && d.rejectionNote == null &&
        d.approvedAt == null && d.paidAt == null && d.paymentReference == null &&
        d.disputeReason == null && d.disputedBy == null && d.disputedAt == null &&
        d.resolutionNote == null && d.resolvedBy == null && d.resolvedAt == null;
    }

    // ───────────────────────── profiles ────────────────────────────
    // Public storefront-style data only. accountType is write-once.

    function profileKeys() {
      return ['uid', 'accountType', 'businessName', 'verificationStatus', 'logoDataUrl',
              'industry', 'description', 'location', 'publicEmail', 'createdAt'];
    }

    function validProfileShape(d, pid) {
      return d.keys().hasOnly(profileKeys()) && d.keys().hasAll(profileKeys()) &&
        d.uid == pid &&
        (d.accountType == null || d.accountType in ['business', 'funder']) &&
        strLen(d.businessName, 1, 120) &&
        d.verificationStatus in ['unverified', 'pending', 'verified'] &&
        (d.logoDataUrl == null || (d.logoDataUrl is string && d.logoDataUrl.size() <= 200000 &&
          d.logoDataUrl.matches('^data:image/(png|jpeg|jpg|webp);base64,.*'))) &&
        (d.industry == null || d.industry in ['manufacturing', 'construction', 'retail', 'food',
          'services', 'logistics', 'technology', 'agriculture', 'creative', 'other']) &&
        strLen(d.description, 0, 600) && strLen(d.location, 0, 120) &&
        (d.publicEmail == '' || isEmail(d.publicEmail)) &&
        d.createdAt is timestamp;
    }

    match /profiles/{pid} {
      allow read: if isAuthed();

      allow create: if isAuthed() && uid() == pid &&
        validProfileShape(request.resource.data, pid) &&
        request.resource.data.verificationStatus in ['unverified', 'pending'] &&
        request.resource.data.createdAt == request.time;

      allow update: if isAuthed() && uid() == pid &&
        validProfileShape(request.resource.data, pid) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        // accountType may be set once (null → value) and never changed after.
        // (Legacy profiles predate the field; `in` guards the missing-key error.)
        (!('accountType' in resource.data) || resource.data.accountType == null ||
         request.resource.data.accountType == resource.data.accountType) &&
        // A client can move to 'pending' but can never grant itself 'verified'.
        (request.resource.data.verificationStatus in ['unverified', 'pending'] ||
         request.resource.data.verificationStatus == resource.data.verificationStatus);

      allow delete: if false;

      // ── Run: the business's own documents (invoices, receipts, statements).
      //    Owner-only. Analysis fields are reserved for the server-side AI.
      match /documents/{docId} {
        function docKeys() {
          return ['kind', 'title', 'documentDate', 'amount', 'counterparty', 'note', 'fileName',
                  'mimeType', 'dataUrl', 'analysisStatus', 'analysisNote', 'createdAt'];
        }
        function validDoc(d) {
          return d.keys().hasOnly(docKeys()) && d.keys().hasAll(docKeys()) &&
            d.kind in ['invoice', 'receipt', 'bank_statement', 'other'] &&
            strLen(d.title, 1, 160) && isIsoDate(d.documentDate) &&
            (d.amount == null || isMoney(d.amount, 100000000)) &&
            strLen(d.counterparty, 0, 160) && strLen(d.note, 0, 1000) &&
            optStr(d.fileName, 160) && optStr(d.mimeType, 64) &&
            (d.dataUrl == null || (d.dataUrl is string && d.dataUrl.size() <= 700000 &&
              d.dataUrl.matches('^data:(image/(png|jpeg|jpg|webp)|application/pdf);base64,.*'))) &&
            d.analysisStatus == 'pending_review' && d.analysisNote == null &&
            d.createdAt is timestamp;
        }
        allow read: if isAuthed() && uid() == pid;
        allow create: if isAuthed() && uid() == pid &&
          accountTypeOf(uid()) == 'business' &&
          validDoc(request.resource.data) &&
          request.resource.data.createdAt == request.time;
        // Documents are evidence — they can be removed but never edited.
        allow update: if false;
        allow delete: if isAuthed() && uid() == pid;
      }
    }

    // ─────────────────────── verifications ─────────────────────────
    // Owner-only. Stores only last-4 digits of identity/bank numbers.

    function verificationKeys() {
      return ['legalName', 'tradingName', 'registrationNumber', 'taxNumber', 'ownerFullName',
              'ownerIdLast4', 'phone', 'email', 'address', 'bankName', 'accountHolder',
              'accountNumberLast4', 'licenceNumber', 'status', 'submittedAt', 'updatedAt'];
    }

    function validVerification(d) {
      return d.keys().hasOnly(verificationKeys()) && d.keys().hasAll(verificationKeys()) &&
        strLen(d.legalName, 1, 160) && strLen(d.tradingName, 0, 160) &&
        strLen(d.registrationNumber, 0, 40) && strLen(d.taxNumber, 0, 40) &&
        strLen(d.ownerFullName, 1, 160) &&
        d.ownerIdLast4 is string && d.ownerIdLast4.matches('^[0-9]{4}$') &&
        strLen(d.phone, 0, 32) && (d.email == '' || isEmail(d.email)) &&
        strLen(d.address, 0, 300) && strLen(d.bankName, 0, 64) &&
        strLen(d.accountHolder, 0, 120) &&
        d.accountNumberLast4 is string && d.accountNumberLast4.matches('^[0-9]{4}$') &&
        strLen(d.licenceNumber, 0, 64) &&
        d.status in ['unverified', 'pending', 'verified'] &&
        optTs(d.submittedAt) && d.updatedAt == request.time;
    }

    match /verifications/{vid} {
      allow read: if isAuthed() && uid() == vid;

      allow create: if isAuthed() && uid() == vid &&
        validVerification(request.resource.data) &&
        request.resource.data.status in ['unverified', 'pending'] &&
        request.resource.data.submittedAt == request.time;

      allow update: if isAuthed() && uid() == vid &&
        validVerification(request.resource.data) &&
        (request.resource.data.status in ['unverified', 'pending'] ||
         request.resource.data.status == resource.data.status) &&
        (request.resource.data.submittedAt == request.time ||
         request.resource.data.submittedAt == resource.data.submittedAt);

      allow delete: if false;
    }

    // ───────────────────────── contracts ───────────────────────────

    match /contracts/{cid} {

      allow read: if isAuthed() && canReadContract(resource.data);

      // Only a verified-submitted BUSINESS may author an agreement (funders observe only).
      allow create: if isAuthed() &&
        validContractShape(request.resource.data) &&
        request.resource.data.smeUid == uid() &&
        accountTypeOf(uid()) == 'business' &&
        hasSubmittedVerification(uid()) &&
        request.resource.data.buyerUid == null &&
        request.resource.data.status in ['draft', 'proposed'] &&
        (
          (request.resource.data.status == 'draft' && request.resource.data.smeAcceptedAt == null) ||
          (request.resource.data.status == 'proposed' && request.resource.data.smeAcceptedAt == request.time)
        ) &&
        request.resource.data.buyerAcceptedAt == null &&
        request.resource.data.lockedAt == null &&
        request.resource.data.completedAt == null &&
        request.resource.data.cancelledBy == null &&
        request.resource.data.cancelReason == null &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if isAuthed() && validContractShape(request.resource.data) &&
        request.resource.data.updatedAt == request.time &&
        // Identity and origin never change.
        request.resource.data.smeUid == resource.data.smeUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (
          smeEditsDraft() || smeProposes() || smeWithdraws() || smeCancelsBeforeLock() ||
          buyerAccepts() || buyerDeclines() || participantClosesActive() || smeTogglesFunding()
        );

      // History is immutable — agreements are cancelled, never deleted.
      allow delete: if false;

      // ── SME may list / unlist the agreement for funders at any live stage.
      //    The only field that changes is the flag — terms stay locked.
      function smeTogglesFunding() {
        return isSmeOf(resource.data) &&
          resource.data.status in ['draft', 'proposed', 'active'] &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['seekingFunding', 'updatedAt']);
      }

      // ── SME, draft only: free to edit terms. Buyer identity stays null.
      function smeEditsDraft() {
        return isSmeOf(resource.data) &&
          resource.data.status == 'draft' &&
          request.resource.data.status == 'draft' &&
          request.resource.data.buyerUid == null &&
          request.resource.data.smeAcceptedAt == null &&
          request.resource.data.buyerAcceptedAt == null &&
          request.resource.data.lockedAt == null &&
          request.resource.data.completedAt == null &&
          request.resource.data.cancelledBy == null &&
          request.resource.data.cancelReason == null;
      }

      // ── SME accepts the terms and sends them to the buyer. Terms freeze.
      function smeProposes() {
        return isSmeOf(resource.data) &&
          resource.data.status == 'draft' &&
          request.resource.data.status == 'proposed' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'smeAcceptedAt', 'updatedAt']) &&
          request.resource.data.smeAcceptedAt == request.time;
      }

      // ── SME pulls a proposal back to draft (buyer has not accepted).
      function smeWithdraws() {
        return isSmeOf(resource.data) &&
          resource.data.status == 'proposed' &&
          request.resource.data.status == 'draft' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'smeAcceptedAt', 'updatedAt']) &&
          request.resource.data.smeAcceptedAt == null;
      }

      function smeCancelsBeforeLock() {
        return isSmeOf(resource.data) &&
          resource.data.status in ['draft', 'proposed'] &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledBy', 'cancelReason', 'updatedAt']) &&
          request.resource.data.cancelledBy == uid() &&
          strLen(request.resource.data.cancelReason, 1, 300);
      }

      // ── The invited buyer claims and accepts. This is the LOCK moment.
      function buyerAccepts() {
        return isInvitedBuyerOf(resource.data) &&
          resource.data.status == 'proposed' &&
          hasSubmittedVerification(uid()) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['buyerUid', 'buyerName', 'buyerAcceptedAt', 'lockedAt', 'status', 'updatedAt']) &&
          request.resource.data.buyerUid == uid() &&
          strLen(request.resource.data.buyerName, 1, 120) &&
          request.resource.data.status == 'active' &&
          request.resource.data.buyerAcceptedAt == request.time &&
          request.resource.data.lockedAt == request.time;
      }

      function buyerDeclines() {
        return isInvitedBuyerOf(resource.data) &&
          resource.data.status == 'proposed' &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledBy', 'cancelReason', 'updatedAt']) &&
          request.resource.data.cancelledBy == uid() &&
          strLen(request.resource.data.cancelReason, 1, 300);
      }

      // ── Once active, the only header changes are close-out or cancellation.
      //    Every term (parties, value, schedule) is immutable.
      function participantClosesActive() {
        return (isSmeOf(resource.data) || isBuyerOf(resource.data)) &&
          resource.data.status == 'active' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'completedAt', 'cancelledBy', 'cancelReason', 'updatedAt']) &&
          (
            (request.resource.data.status == 'completed' &&
             request.resource.data.completedAt == request.time &&
             request.resource.data.cancelledBy == null &&
             request.resource.data.cancelReason == null) ||
            (request.resource.data.status == 'cancelled' &&
             request.resource.data.completedAt == null &&
             request.resource.data.cancelledBy == uid() &&
             strLen(request.resource.data.cancelReason, 1, 300))
          );
      }

      // ──────────────── private: settlement details ──────────────
      // The SME's bank / PayShap details. Only the two parties may read.
      // Funders observing a listed agreement never reach this document.
      // Written alongside the draft; frozen once the agreement leaves draft.

      match /private/payment {
        allow read: if isAuthed() && isParticipant(parentNow(cid));

        allow create, update: if isAuthed() &&
          parentAfter(cid).smeUid == uid() &&
          parentAfter(cid).status == 'draft' &&
          validPaymentInstructions(request.resource.data.details) &&
          request.resource.data.keys().hasOnly(['details', 'updatedAt']) &&
          request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // ─────────────────────── milestones ────────────────────────

      match /milestones/{mid} {

        allow read: if isAuthed() && canReadContract(parentNow(cid));

        // Authoring — SME, parent must be (or be becoming) a draft.
        allow create: if isAuthed() &&
          parentAfter(cid).smeUid == uid() &&
          parentAfter(cid).status == 'draft' &&
          validMilestoneShape(request.resource.data, cid) &&
          isCleanMilestone(request.resource.data) &&
          request.resource.data.updatedAt == request.time;

        allow delete: if isAuthed() &&
          parentAfter(cid).smeUid == uid() &&
          parentAfter(cid).status == 'draft';

        allow update: if isAuthed() &&
          validMilestoneShape(request.resource.data, cid) &&
          request.resource.data.updatedAt == request.time &&
          (
            smeEditsMilestoneTerms() ||
            (parentAfter(cid).status == 'active' && (
              smeSubmitsEvidence() || smeWithdrawsEvidence() ||
              buyerApproves() || buyerRejectsEvidence() || buyerRecordsPayment() ||
              participantRaisesDispute() || participantResolvesDispute()
            ))
          );

        function m() { return resource.data; }
        function n() { return request.resource.data; }
        function changed() { return n().diff(m()).affectedKeys(); }
        function smeHere() { return parentAfter(cid).smeUid == uid(); }
        function buyerHere() { return parentAfter(cid).buyerUid == uid(); }

        // Terms editable only while the agreement is a draft.
        function smeEditsMilestoneTerms() {
          return smeHere() && parentAfter(cid).status == 'draft' && isCleanMilestone(n());
        }

        // SME: pending → evidence_submitted. Evidence is mandatory and stamped.
        function smeSubmitsEvidence() {
          return smeHere() &&
            m().status == 'pending' && n().status == 'evidence_submitted' &&
            changed().hasOnly(['status', 'evidence', 'rejectionNote', 'updatedAt']) &&
            n().evidence != null &&
            n().evidence.submittedBy == uid() &&
            n().evidence.submittedAt == request.time &&
            n().rejectionNote == null;
        }

        // SME: evidence_submitted → pending (take it back before review).
        function smeWithdrawsEvidence() {
          return smeHere() &&
            m().status == 'evidence_submitted' && n().status == 'pending' &&
            changed().hasOnly(['status', 'evidence', 'updatedAt']) &&
            n().evidence == null;
        }

        // Buyer: evidence_submitted → approved. Payment request goes live.
        function buyerApproves() {
          return buyerHere() &&
            m().status == 'evidence_submitted' && n().status == 'approved' &&
            changed().hasOnly(['status', 'approvedAt', 'updatedAt']) &&
            n().approvedAt == request.time;
        }

        // Buyer: evidence_submitted → pending with a written reason. Evidence
        // is retained for the record; the SME's resubmission replaces it.
        function buyerRejectsEvidence() {
          return buyerHere() &&
            m().status == 'evidence_submitted' && n().status == 'pending' &&
            changed().hasOnly(['status', 'rejectionNote', 'updatedAt']) &&
            strLen(n().rejectionNote, 1, 300);
        }

        // Buyer: approved → paid, with the bank/PayShap reference.
        function buyerRecordsPayment() {
          return buyerHere() &&
            m().status == 'approved' && n().status == 'paid' &&
            changed().hasOnly(['status', 'paidAt', 'paymentReference', 'updatedAt']) &&
            n().paidAt == request.time &&
            strLen(n().paymentReference, 1, 64);
        }

        // Either party may dispute a stage that is under review or awaiting payment.
        function participantRaisesDispute() {
          return (smeHere() || buyerHere()) &&
            m().status in ['evidence_submitted', 'approved'] && n().status == 'disputed' &&
            changed().hasOnly(['status', 'disputeReason', 'disputedBy', 'disputedAt', 'updatedAt']) &&
            strLen(n().disputeReason, 1, 2000) &&
            n().disputedBy == uid() &&
            n().disputedAt == request.time;
        }

        // Resolution back to 'pending' (rework) may come from either side.
        // Resolution to 'approved' commits the buyer to pay, so only the buyer may do it.
        function participantResolvesDispute() {
          return (smeHere() || buyerHere()) &&
            m().status == 'disputed' &&
            changed().hasOnly(['status', 'resolutionNote', 'resolvedBy', 'resolvedAt', 'approvedAt', 'updatedAt']) &&
            strLen(n().resolutionNote, 1, 2000) &&
            n().resolvedBy == uid() &&
            n().resolvedAt == request.time &&
            (
              (n().status == 'pending' && n().approvedAt == null) ||
              (n().status == 'approved' && buyerHere() && n().approvedAt == request.time)
            );
        }
      }

      // ─────────────────────── audit events ──────────────────────
      // Append-only. The actor is always the caller, the claimed role must be
      // the caller's real role on the agreement, and every event type must
      // accompany the exact state transition it describes (checked against the
      // pre- and post-batch state). A participant therefore cannot forge an
      // audit entry such as "payment recorded" without the payment itself.

      function eventRoleMatches(e, after) {
        return (e.actorRole == 'sme' && isSmeOf(after)) ||
               (e.actorRole == 'buyer' && (isBuyerOf(after) || isInvitedBuyerOf(after)));
      }

      function contractEventValid(e, cid, after) {
        return e.milestoneId == null && (
          (e.type == 'contract_created' && e.actorRole == 'sme' &&
            after.status == 'draft' && after.createdAt == request.time) ||
          (e.type == 'contract_proposed' && e.actorRole == 'sme' &&
            parentNow(cid).status == 'draft' && after.status == 'proposed') ||
          (e.type == 'contract_withdrawn' && e.actorRole == 'sme' &&
            parentNow(cid).status == 'proposed' && after.status == 'draft') ||
          (e.type == 'contract_accepted' && e.actorRole == 'buyer' &&
            parentNow(cid).status == 'proposed' && after.status == 'active') ||
          (e.type == 'contract_declined' && e.actorRole == 'buyer' &&
            parentNow(cid).status == 'proposed' && after.status == 'cancelled') ||
          (e.type == 'contract_cancelled' &&
            parentNow(cid).status != 'cancelled' && after.status == 'cancelled') ||
          (e.type == 'contract_completed' &&
            parentNow(cid).status == 'active' && after.status == 'completed') ||
          (e.type == 'contract_listed_for_funding' && e.actorRole == 'sme' &&
            parentNow(cid).seekingFunding == false && after.seekingFunding == true) ||
          (e.type == 'contract_unlisted_for_funding' && e.actorRole == 'sme' &&
            parentNow(cid).seekingFunding == true && after.seekingFunding == false)
        );
      }

      function milestoneEventValid(e, cid) {
        return e.milestoneId is string && (
          (e.type == 'milestone_evidence_submitted' && e.actorRole == 'sme' &&
            milestoneNow(cid, e.milestoneId).status == 'pending' &&
            milestoneAfter(cid, e.milestoneId).status == 'evidence_submitted') ||
          (e.type == 'milestone_evidence_withdrawn' && e.actorRole == 'sme' &&
            milestoneNow(cid, e.milestoneId).status == 'evidence_submitted' &&
            milestoneAfter(cid, e.milestoneId).status == 'pending') ||
          (e.type == 'milestone_rejected' && e.actorRole == 'buyer' &&
            milestoneNow(cid, e.milestoneId).status == 'evidence_submitted' &&
            milestoneAfter(cid, e.milestoneId).status == 'pending') ||
          (e.type == 'milestone_approved' && e.actorRole == 'buyer' &&
            milestoneNow(cid, e.milestoneId).status == 'evidence_submitted' &&
            milestoneAfter(cid, e.milestoneId).status == 'approved') ||
          (e.type == 'milestone_paid' && e.actorRole == 'buyer' &&
            milestoneNow(cid, e.milestoneId).status == 'approved' &&
            milestoneAfter(cid, e.milestoneId).status == 'paid') ||
          (e.type == 'milestone_disputed' &&
            milestoneNow(cid, e.milestoneId).status in ['evidence_submitted', 'approved'] &&
            milestoneAfter(cid, e.milestoneId).status == 'disputed') ||
          (e.type == 'milestone_dispute_resolved' &&
            milestoneNow(cid, e.milestoneId).status == 'disputed' &&
            milestoneAfter(cid, e.milestoneId).status in ['pending', 'approved'])
        );
      }

      match /events/{eid} {
        allow read: if isAuthed() && canReadContract(parentNow(cid));

        allow create: if isAuthed() &&
          isActorOn(parentAfter(cid)) &&
          request.resource.data.keys().hasOnly(['type', 'actorUid', 'actorRole', 'milestoneId', 'summary', 'at']) &&
          request.resource.data.keys().hasAll(['type', 'actorUid', 'actorRole', 'milestoneId', 'summary', 'at']) &&
          request.resource.data.actorUid == uid() &&
          request.resource.data.actorRole in ['sme', 'buyer'] &&
          eventRoleMatches(request.resource.data, parentAfter(cid)) &&
          optStr(request.resource.data.milestoneId, 64) &&
          strLen(request.resource.data.summary, 1, 500) &&
          request.resource.data.at == request.time &&
          (contractEventValid(request.resource.data, cid, parentAfter(cid)) ||
           milestoneEventValid(request.resource.data, cid));

        allow update, delete: if false;
      }
    }

    // ───────────────────── Default deny ────────────────────────────
    // Legacy POS collections (users/*, storefronts/*) are intentionally
    // no longer reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
